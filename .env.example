# Environment Variables Template
# Copy to .env for local development

# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expense_tracker?schema=public"

# Auth.js / NextAuth Configuration
NEXTAUTH_SECRET="development-nextauth-secret-key-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# API Rate Limiting (IP-keyed, fixed window). Defaults: 100 requests / 60 seconds.
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000

# AI Provider Configuration (Phase v1.0+)
AI_PROVIDER="claude"
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""

# Billing Provider Configuration (Paid Tier / Flutterwave)
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""
